{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo (daily)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "MSVC Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci",
      "displayName": "CI (needs sccache)",
      "description": "GitHub's build: Release has the shipping build's optimisation without its debug info, which would overflow the cache.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
      }
    }
  ],
  "buildPresets": [
    { "name": "ninja-msvc-debug", "configurePreset": "ninja-msvc-debug" },
    { "name": "ninja-msvc-relwithdebinfo", "configurePreset": "ninja-msvc-relwithdebinfo" },
    { "name": "ninja-msvc-release", "configurePreset": "ninja-msvc-release" },
    { "name": "ci", "configurePreset": "ci", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "ninja-msvc-debug", "configurePreset": "ninja-msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "ninja-msvc-relwithdebinfo", "configurePreset": "ninja-msvc-relwithdebinfo", "output": { "outputOnFailure": true } },
    { "name": "ninja-msvc-release", "configurePreset": "ninja-msvc-release", "output": { "outputOnFailure": true } }
  ]
}
